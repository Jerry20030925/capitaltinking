# ============================================================================
#  capitaltinking — configuration
#  Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# ---- SAFETY SWITCHES (read these carefully) --------------------------------
# TRADING_MODE: "demo" (fake money, safe) or "live" (REAL money on your account)
# Leave this on "demo" until you have watched it behave for a long time.
TRADING_MODE=demo

# DRY_RUN: "true" = only log the trades it WOULD make, never actually place them.
# "false" = actually send orders to whichever account TRADING_MODE points at.
# Keep this "true" even in demo until you trust the decisions.
DRY_RUN=true

# ---- Capital.com credentials -----------------------------------------------
# Create an API key in Capital.com: Settings -> API integrations.
# Use your DEMO account credentials while TRADING_MODE=demo.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=          # your Capital.com login email
CAPITAL_PASSWORD=            # your Capital.com password (or API key custom password)

# ---- DeepSeek (the "brain") ------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- News source -----------------------------------------------------------
# Optional NewsAPI.org key for richer news. If empty, free RSS feeds are used.
NEWS_API_KEY=

# ---- Risk controls (hard limits the AI can never override) ------------------
# The instruments the bot is ALLOWED to consider trading. Comma separated
# Capital.com "epics". Keep this list short and known.
ALLOWED_EPICS=GOLD,SILVER,US500,OIL_CRUDE,BTCUSD,EURUSD

# Max size (in Capital.com units) for any single position.
MAX_POSITION_SIZE=1

# Max number of open positions at any time.
MAX_OPEN_POSITIONS=3

# Refuse to trade if account balance is below this (account currency).
MIN_ACCOUNT_BALANCE=100

# Stop-loss / take-profit as a percent distance from entry (risk management).
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4

# Minimum confidence (0-1) the AI must report before a trade is allowed.
MIN_CONFIDENCE=0.65

# Loop interval in minutes when running in --loop mode.
LOOP_INTERVAL_MINUTES=60

# ---- Notifications (optional) ----------------------------------------------
# Configure ONE provider below (priority: Telegram > Twilio > CallMeBot).
# NOTIFY_ON: "actions" = only message when a trade opens/closes (default),
#            "all"     = also message on cycles that only HOLD.
NOTIFY_ON=actions

# Option A — Telegram (recommended: free, instant, reliable).
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Send your new bot any message.
# 3. Run: npm run telegram-setup   (prints your chat id) -> put it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B — Twilio WhatsApp (production-grade).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=       # e.g. whatsapp:+14155238886
WHATSAPP_TO=               # e.g. whatsapp:+15551234567

# Option C — CallMeBot WhatsApp (free, but often slow/unreliable).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
