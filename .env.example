# ============================================================================
#  capitaltinking — configuration
#  Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# ---- SAFETY SWITCHES (read these carefully) --------------------------------
# TRADING_MODE: "demo" (fake money, safe) or "live" (REAL money on your account)
# Leave this on "demo" until you have watched it behave for a long time.
TRADING_MODE=demo

# DRY_RUN: "true" = only log the trades it WOULD make, never actually place them.
# "false" = actually send orders to whichever account TRADING_MODE points at.
# Keep this "true" even in demo until you trust the decisions.
DRY_RUN=true

# ---- Capital.com credentials -----------------------------------------------
# Create an API key in Capital.com: Settings -> API integrations.
# Use your DEMO account credentials while TRADING_MODE=demo.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=          # your Capital.com login email
CAPITAL_PASSWORD=            # your Capital.com password (or API key custom password)

# ---- DeepSeek (the primary "brain") ----------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Second brain: Qwen (independent Chief Trader, ensemble diversity) ------
# A DIFFERENT model (Alibaba Qwen via DashScope). When QWEN_API_KEY is set, a
# second brain votes on every decision. Two different models agreeing = higher
# conviction; disagreement = caution. SECOND_BRAIN_MODE:
#   observe = record both + agreement, trade the primary's calls (A/B). START HERE.
#   enforce = a BUY/SELL needs BOTH brains to agree, else HOLD (conservative).
#   either  = OR-logic: trade if EITHER brain sees an opportunity — no need for
#             both to agree. Most aggressive (more trades, more chances to profit).
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
SECOND_BRAIN_MODE=observe

# ---- News source -----------------------------------------------------------
# Optional NewsAPI.org key for richer news. If empty, free RSS feeds are used.
NEWS_API_KEY=

# ---- Risk controls (hard limits the AI can never override) ------------------
# The instruments the bot is ALLOWED to consider trading. Comma separated
# Capital.com "epics". Keep this list short and known.
ALLOWED_EPICS=GOLD,SILVER,US500,OIL_CRUDE,BTCUSD,EURUSD

# Optional HARD lot ceiling per position (in Capital.com units).
# 0 = no fixed-lot ceiling — let capital-%/margin/loss-cap decide the size.
# Set a small number only if you want to clamp lots regardless of capital.
MAX_POSITION_SIZE=0

# Max number of open positions at any time. Higher = fund more promising ideas
# at once and deploy more of your available funds (trades are funded best-first).
MAX_OPEN_POSITIONS=5

# Refuse to trade if account balance is below this (account currency).
MIN_ACCOUNT_BALANCE=100

# Stop-loss / take-profit as a percent distance from entry (risk management).
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4

# Minimum confidence (0-1) the AI must report before a trade is allowed.
MIN_CONFIDENCE=0.65
# Minimum composite opportunity score (0-100, trend+technical+momentum+news+macro
# confluence). Below this = no statistical edge = no trade; above it, position size
# scales with the score so only genuinely high-quality setups get big positions.
MIN_SIGNAL_SCORE=55
# Expected-Value gate: once a setup (momentum/breakout/…) has ≥ MIN_EV_SAMPLE
# realised round-trips, block new trades of it if its measured expectancy
# (avg R-multiple) < MIN_EV_R. Stops feeding a losing playbook; thin samples are
# never gated. Raise MIN_EV_R above 0 to demand a proven positive edge.
MIN_EV_SAMPLE=8
MIN_EV_R=0

# ---- Position sizing (RISK is the control; capital % is only a ceiling) -----
# SIZING_MODE:
#   "capital" = DYNAMIC RISK-BASED (default): risk-per-trade scales with the
#               brain's signal strength; size = riskBudget / stopDistance, so a
#               tighter stop buys a bigger position at the SAME risk. Capital % is
#               only a utilisation ceiling. Maximises return per unit of risk.
#   "risk"    = simple fixed risk-to-stop (~RISK_PER_TRADE_PCT per trade).
SIZING_MODE=capital
# Capital-UTILISATION CEILING: most margin one trade may commit, % of available.
# 100 = may use all available funds. This is NOT a loss limit.
CAPITAL_DEPLOY_PCT=100
# Dynamic risk band: risk-per-trade scales weak→strong signal between these.
TARGET_RISK_MIN_PCT=0.5
TARGET_RISK_MAX_PCT=1.5
# ABSOLUTE per-trade risk ceiling: a single stop-out never loses more than this %
# of equity (positions scaled DOWN to fit). The hard cap above the risk band.
MAX_TRADE_LOSS_PCT=2

# ---- Circuit breakers (portfolio-level guard — always on) ------------------
# "risk" mode only: fixed % of equity risked per trade. Ignored in capital mode.
RISK_PER_TRADE_PCT=0.5
# Realised P/L (from the ledger). On breach the risk engine halts ALL new opens
# until the window rolls off; closes stay allowed.
MAX_DAILY_LOSS_PCT=3
MAX_WEEKLY_LOSS_PCT=7
MAX_DRAWDOWN_PCT=10
# Cold-streak guard: halt new opens after this many consecutive losses (resets on
# a win). 0 = disabled.
MAX_CONSECUTIVE_LOSSES=4

# ---- Devil's Advocate (a second AI that argues against every trade) ---------
# DEVIL_ADVOCATE: "true" runs an adversarial critic on each BUY/SELL proposal.
DEVIL_ADVOCATE=true
# DEVIL_MODE: "observe" = record the critic's verdict but DON'T block (so trades
#             still open and you can A/B whether vetoing would have helped).
#             "enforce" = downgrade vetoed trades to HOLD.
# START IN observe. Only switch to enforce once `npm run stats` shows the veto
# improves win-rate / expectancy / profit factor on a big enough sample.
DEVIL_MODE=observe
# counterConfidence (0-1) at/above which the critic "would veto" a trade.
DEVIL_VETO_THRESHOLD=0.7

# Loop interval in minutes when running in --loop mode.
LOOP_INTERVAL_MINUTES=60

# ---- Notifications (optional) ----------------------------------------------
# Configure ONE provider below (priority: Telegram > Twilio > CallMeBot).
# NOTIFY_ON: "actions" = only message when a trade opens/closes (default),
#            "all"     = also message on cycles that only HOLD.
NOTIFY_ON=actions
# Messages are BATCHED: at most one push every NOTIFY_INTERVAL_MINUTES, no matter
# how fast the loop runs. Actions in the window are sent together; if nothing
# happened a short heartbeat check-in goes out. Default 120 = one message /2h.
NOTIFY_INTERVAL_MINUTES=120

# Option A — Telegram (recommended: free, instant, reliable).
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Send your new bot any message.
# 3. Run: npm run telegram-setup   (prints your chat id) -> put it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B — Twilio WhatsApp (production-grade).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=       # e.g. whatsapp:+14155238886
WHATSAPP_TO=               # e.g. whatsapp:+15551234567

# Option C — CallMeBot WhatsApp (free, but often slow/unreliable).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
