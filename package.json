{
  "name": "capitaltinking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "News-driven trading assistant for Capital.com using DeepSeek as the reasoning brain. DEMO + dry-run by default.",
  "scripts": {
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "loop": "tsx src/index.ts --loop",
    "status": "tsx src/index.ts --status",
    "report": "tsx src/index.ts --report",
    "stats": "tsx src/index.ts --stats",
    "telegram-setup": "tsx src/index.ts --telegram-setup",
    "test-notify": "tsx src/index.ts --test-notify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
